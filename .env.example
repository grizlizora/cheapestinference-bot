# ==========================================
# Telegram Bot Configuration
# ==========================================
BOT_TOKEN=1234567890:ABCdefGHIJklmNoPQRsTUVwxyZ_example
ADMIN_USER_IDS=

# ==========================================
# Storage & Server Configuration
# ==========================================
DB_PATH=./data/bot.db
PORT=7860
NODE_ENV=development

# ==========================================
# Tor & Proxy Configuration
# ==========================================
TOR_ENABLED=false
TOR_SOCKS_HOST=127.0.0.1
TOR_SOCKS_PORT=9050
TOR_CONTROL_HOST=127.0.0.1
TOR_CONTROL_PORT=9051
TOR_CONTROL_PASSWORD=

# Optional external proxy list (comma-separated: http://ip:port, socks5://ip:port)
PROXY_LIST=

# Allow direct connection fallback if Tor/proxies fail
ALLOW_DIRECT_FALLBACK=true

# ==========================================
# Scraper & Monitoring Interval (in seconds)
# ==========================================
SCRAPE_MIN_INTERVAL_SEC=15
SCRAPE_MAX_INTERVAL_SEC=35
SCRAPE_MAX_BACKOFF_SEC=300
